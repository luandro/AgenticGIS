# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Tests
.pytest_cache/
.coverage
htmlcov/

# IDE / tooling
.opencode/
.claude/
.vscode/
.idea/
.poolside/

# OS
.DS_Store
Thumbs.db

# QGIS
*.qgs~
*.qgz~

# QGIS style databases — auto-created when the plugin references
# style APIs, but the plugin ships no symbol library.
*.db

# Local env & runtime logs
.env
*.log

# Internal development — not for public release
dev/
docs/
tests/

# Markdown files (except README)
*.md
!README.md
# Local tooling & scripts
setup.cfg
build_release.sh
*.zip

# Compatibility docs (local reference only)
QGIS_COMPATIBILITY_RULES.md

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local search config for graft (re-admits graft/ to ripgrep/fd). Local-only,
# like graft/ itself — ripgrep reads it from disk whether or not git tracks it.
/.ignore

# Local reference clones (upstream repos checked out for reading)
/.worktrees/

# Model-catalog exports from local tooling — regenerable, not part of the plugin
/free_models*.csv
/free_models*.json
